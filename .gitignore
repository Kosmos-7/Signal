# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Environnements virtuels
venv/
.venv/

# Secrets — jamais committables (le projet fonctionne par variables d'environnement)
.env
.env.*

# Logs
*.log

# IDE / Claude Code workspace
.claude/launch.json
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/
WatchRadar-main/.claude/

# Backup files
*.bak
*.backup-*

# Fichiers temporaires d'écriture atomique. charts/ est balayé en bloc par le
# `git add charts/` du workflow : un .tmp resté au sol après un run tué serait
# committé et servi. Le motif ne masque rien au garde anti-oubli du CI, dont le
# pathspec est '*.json'.
*.json.tmp

# Artifacts
migration_*_report.txt

# Dev scaffolding (jamais en prod)
maquette_fiche.html

# OS
.DS_Store
Thumbs.db
